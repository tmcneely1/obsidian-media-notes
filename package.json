{
	"name": "media-notes-plugin",
	"version": "1.6.2",
	"description": "Obsidian plugin for taking notes on YouTube videos and podcasts with media controls and timestamps.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest",
		"bookmarklet": "bun ./src/convert-bookmarklet.ts",
		"bookmarklet-page": "open dist/index.html",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^16.11.6",
		"@types/react": "^18.2.42",
		"@types/react-dom": "^18.2.17",
		"@types/react-transition-group": "^4.4.10",
		"@types/youtube-player": "^5.5.11",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"jest-environment-jsdom": "^29.7.0",
		"jsdom": "^24.0.0",
		"obsidian": "^1.14.4",
		"ts-jest": "^29.4.15",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"jest": "^29.7.0"
	},
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-transition-group": "^4.4.5",
		"react-youtube": "^10.1.0"
	},
	"jest": {
		"testEnvironment": "jsdom",
		"transform": {
			"^.+\\.tsx?$": [
				"ts-jest",
				{
					"tsconfig": {
						"jsx": "react",
						"esModuleInterop": true
					}
				}
			]
		},
		"testMatch": [
			"**/__tests__/**/*.(test|spec).(js|ts|tsx)"
		]
	}
}
